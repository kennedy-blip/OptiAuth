NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Unsafe demonstration only; never enable for real authentication or sensitive data.
ENABLE_UNSAFE_BIOMETRIC_DEMO=false
# Experimental, auxiliary-only action. Keep disabled until independently reviewed and tested.
ENABLE_EXPERIMENTAL_SESSION_EYE_CHECK=false
# Configure only a single-IP header guaranteed to be overwritten by your trusted ingress.
BIOMETRIC_TRUSTED_IP_HEADER=
# Random secret, at least 32 bytes; never commit or reuse for other purposes.
BIOMETRIC_HMAC_SECRET=
# Experimental passkeys: keep disabled until isolated integration and security tests pass.
ENABLE_EXPERIMENTAL_PASSKEYS=false
# Exact HTTPS origin and hostname (http://localhost is permitted for local development).
PASSKEY_ORIGIN=
PASSKEY_RP_ID=
# Base64url-encoded random key of at least 32 bytes, dedicated to passkey assertions.
PASSKEY_ASSERTION_SECRET=
